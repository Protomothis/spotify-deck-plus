{
	"name": "spotify-deck-plus",
	"version": "0.1.2",
	"description": "Spotify controls for the Elgato Stream Deck +: playback keys, a volume dial and a folder-style library browser.",
	"author": "Protomothis",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Protomothis/spotify-deck-plus.git"
	},
	"homepage": "https://github.com/Protomothis/spotify-deck-plus#readme",
	"bugs": {
		"url": "https://github.com/Protomothis/spotify-deck-plus/issues"
	},
	"keywords": [
		"stream-deck",
		"stream-deck-plus",
		"elgato",
		"spotify",
		"streamdeck-plugin"
	],
	"private": true,
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"npm run restart\"",
		"typecheck": "tsc --noEmit",
		"validate": "streamdeck validate com.protomothis.spotify-deck-plus.sdPlugin",
		"link": "streamdeck link com.protomothis.spotify-deck-plus.sdPlugin",
		"restart": "pkill -f com.protomothis.spotify-deck-plus.sdPlugin/bin/plugin.js; sleep 4; pgrep -f com.protomothis.spotify-deck-plus.sdPlugin/bin/plugin.js >/dev/null && echo restarted",
		"pack": "streamdeck pack com.protomothis.spotify-deck-plus.sdPlugin --output dist",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.6"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.5",
		"@elgato/utils": "^0.7.0",
		"@eslint/js": "^9.39.5",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^15.3.1",
		"@rollup/plugin-terser": "^1.0.2",
		"@rollup/plugin-typescript": "^12.3.1",
		"@tsconfig/node20": "^20.1.11",
		"@types/node": "~24.1.0",
		"eslint": "^9.39.5",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"rollup": "^4.68.8",
		"tslib": "^2.9.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.74.0",
		"vitest": "^5.1.2"
	}
}
